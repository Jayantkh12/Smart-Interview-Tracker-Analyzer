# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to GitHub.

# ── Database (Aiven / TiDB Cloud / any MySQL host) ──────────
MYSQL_HOST=your-database-host
MYSQL_USER=your-database-user
MYSQL_PASSWORD=your-database-password
MYSQL_DATABASE=smart_interview_tracker
MYSQL_PORT=3306

# ── Server ───────────────────────────────────────────────────
PORT=10000
NODE_ENV=production

# ── Auth ─────────────────────────────────────────────────────
# Generate a strong random string, e.g.: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key

# ── Gmail (Contact Form / Password Reset emails) ─────────────
# Use a Gmail App Password (not your real password)
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-gmail-app-password

# ── URLs ─────────────────────────────────────────────────────
# Set FRONTEND_URL to your Vercel deployment URL (enables CORS)
FRONTEND_URL=https://your-app.vercel.app
BASE_URL=https://smart-interview-tracker-api.onrender.com
